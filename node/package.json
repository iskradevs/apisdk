{
  "name": "@iskradevs/apisdk",
  "version": "0.1.0",
  "description": "TypeScript and JavaScript client for the Iskra Headless API",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iskradevs/apisdk.git",
    "directory": "node"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "examples"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:package": "node scripts/test-package.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "eventsource-parser": "3.1.0"
  },
  "devDependencies": {
    "typescript": "5.9.2"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  }
}
